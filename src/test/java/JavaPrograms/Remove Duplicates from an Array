class Main {
    public static void main(String[] args) 
    {
        
       int a[] = {1,2,2,3,4,5,5,6};
       
       for(int i=0;i<a.length;i++)
       {
           boolean found = false;
           
           for(int j = i+1;j<a.length;j++)
           {
               if(a[i]==a[j])
               {
                   found = true;
                   break;
               }
           }
           
           if(!found)
           {
               System.out.println(a[i]);
           }
       }
        
    }
}
